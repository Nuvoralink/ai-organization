* text=auto
*.md text eol=lf
# Cursor rule files. Without this they fall to `* text=auto` and check out CRLF on Windows while a
# consuming project's copy is LF — byte-identical per git, yet reported as permanent overlay drift.
*.mdc text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.template text eol=lf

# Preserve authored Markdown hard-breaks and upstream formatting in materialized skill/dependency packages.
skills/** whitespace=-blank-at-eol,-blank-at-eof
dependencies/** whitespace=-blank-at-eol,-blank-at-eof
