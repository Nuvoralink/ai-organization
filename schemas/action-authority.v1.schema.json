{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvoralink.internal/schemas/action-authority.v1.schema.json",
  "title": "Action authority policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "default", "autonomous", "conditional", "human_required", "explicitly_deferred"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "default": { "const": "human_required" },
    "autonomous": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "conditional": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["all", "on_uncertainty"],
        "properties": {
          "all": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "on_uncertainty": { "const": "human_required" }
        }
      }
    },
    "human_required": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "explicitly_deferred": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
