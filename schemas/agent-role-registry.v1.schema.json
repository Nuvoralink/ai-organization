{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvoralink.internal/schemas/agent-role-registry.v1.schema.json",
  "title": "Agent role registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "roles"],
  "properties": {
    "version": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "trigger", "mode", "strength", "incompatible_with", "required_outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
          "purpose": { "type": "string", "minLength": 10 },
          "trigger": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "mode": { "enum": ["orchestrate", "implement", "review_read_only", "verify_runtime", "advise"] },
          "strength": { "enum": ["fast", "implementation", "strongest_available"] },
          "vendor_preference": { "enum": ["claude", "codex", "either"] },
          "incompatible_with": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "required_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
