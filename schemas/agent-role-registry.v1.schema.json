{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvoralink.internal/schemas/agent-role-registry.v1.schema.json",
  "title": "Agent role registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "roles"],
  "properties": {
    "$schema": { "const": "../schemas/agent-role-registry.v1.schema.json" },
    "version": { "type": "string" },
    "roles": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/$defs/role" },
          {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/rolePropertyName" }
          }
        ]
      }
    }
  },
  "$defs": {
    "rolePropertyName": {
      "enum": [
        "id",
        "purpose",
        "trigger",
        "mode",
        "strength",
        "vendor_preference",
        "incompatible_with",
        "required_outputs",
        "execution",
        "verdict_rubric"
      ]
    },
    "role": {
      "type": "object",
      "required": ["id", "purpose", "trigger", "mode", "strength", "incompatible_with", "required_outputs", "execution"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "purpose": { "type": "string", "minLength": 10 },
        "trigger": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "mode": { "enum": ["orchestrate", "implement", "review_read_only", "verify_runtime", "advise"] },
        "strength": { "enum": ["fast", "implementation", "strongest_available"] },
        "vendor_preference": { "enum": ["claude", "codex", "either"] },
        "incompatible_with": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "required_outputs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "execution": { "$ref": "#/$defs/execution" },
        "verdict_rubric": { "$ref": "#/$defs/verdictRubric" }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allow"],
          "properties": {
            "allow": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "deny": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_usd", "enforcement"],
          "properties": {
            "max_usd": { "type": "number", "exclusiveMinimum": 0 },
            "enforcement": { "enum": ["dormant", "enforced"] }
          }
        }
      }
    },
    "verdictRubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_floor", "criteria"],
      "properties": {
        "coverage_floor": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "criteria": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "weight", "critical", "summary"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
              "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "critical": { "type": "boolean" },
              "summary": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    }
  }
}
