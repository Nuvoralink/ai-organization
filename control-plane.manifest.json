{
  "version": "1.0.0",
  "deny": {
    "segments": [
      ".git",
      ".env",
      "credentials",
      "secrets",
      "sessions",
      "history",
      "logs",
      "telemetry",
      "cache",
      ".cache",
      "node_modules",
      "dist",
      "build",
      "coverage",
      "__pycache__"
    ],
    "filenames": [
      ".credentials.json",
      "auth.json",
      "credentials.json",
      "settings.local.json",
      "config.toml",
      "default.rules"
    ],
    "prefixes": [
      ".env"
    ],
    "extensions": [
      ".pem",
      ".key",
      ".pfx",
      ".p12",
      ".log",
      ".sqlite",
      ".db",
      ".pyc",
      ".pyo"
    ]
  },
  "mappings": [
    {
      "id": "global-claude-doctrine",
      "source": "global/claude/CLAUDE.md",
      "captureFrom": "${HOME}/.claude/CLAUDE.md",
      "destinations": [
        "${HOME}/.claude/CLAUDE.md"
      ],
      "mode": "file",
      "allowedExtensions": [
        ".md"
      ],
      "ownership": "canonical",
      "exclude": [],
      "detectLocalOnly": true,
      "allowRootLink": false,
      "allowInstalledRootLink": false,
      "lock": "${HOME}/.nuvoralink-control-plane/installed-lock.json"
