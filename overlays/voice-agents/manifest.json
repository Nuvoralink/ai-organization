{
  "version": "1.0.0",
  "project": "voice-agents",
  "rootToken": "PROJECT:voice-agents",
  "deny": {
    "segments": [".git", ".env", "credentials", "secrets", "sessions", "history", "logs", "telemetry", "cache", ".cache", "node_modules", "dist", "build", "coverage", "__pycache__"],
    "filenames": [".credentials.json", "auth.json", "credentials.json", "settings.local.json", "config.toml", "default.rules"],
    "prefixes": [".env"],
    "extensions": [".pem", ".key", ".pfx", ".p12", ".log", ".sqlite", ".db", ".pyc", ".pyo"]
  },
  "mappings": [
    {
      "id": "voice-agents-organization-metadata",
      "source": "overlays/voice-agents/control-plane",
      "captureFrom": "${PROJECT:voice-agents}/.ai-organization/control-plane",
      "destinations": ["${PROJECT:voice-agents}/.ai-organization/control-plane"],
      "mode": "tree",
      "ownership": "generated",
      "allowedExtensions": [".json"],
      "exclude": ["registries/agent-roles.project.v1.json"],
      "detectLocalOnly": true,
      "renderContentTokens": false,
      "allowRootLink": false,
      "allowInstalledRootLink": false,
      "lock": "${HOME}/.nuvoralink-control-plane/project-locks/voice-agents/overlay-lock.json"
    },
    {
      "id": "voice-agents-action-authority",
