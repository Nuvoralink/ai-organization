{
  "schemaVersion": 1,
  "integration_branch": "main",
  "lifecycle_hook_timeout_ms": 1800000,
  "lifecycle_timeout_safety_margin_ms": 60000,
  "lifecycle_roles_by_completion_mode": {
    "read-only": [
      "codex-backend-implementer",
      "sprint-implementer",
      "adversarial-reviewer"
    ],
    "implementation": [
      "codex-backend-implementer",
      "sprint-implementer"
    ]
  },
  "lifecycle_supported_risk_classes": [
    "control_plane"
  ],
  "risk_path_rules": [
    {
      "risk_class": "control_plane",
      "include": [
        ".ai-organization/**",
        ".claude/**",
        ".cursor/rules/**",
        ".github/**",
        "scripts/**",
        "AGENTS.md",
        "CLAUDE.md",
        "REPO_FILEMAP.md",
        "package.json"
      ]
    }
  ],
  "profiles": {
    "control": {
      "commands": [
        "typecheck",
        "lint",
        "format:check",
        "gate:rules-wiring",
        "gate:agent-context",
        "gate:agent-control-plane",
        "gate:fleet-parity",
        "gate:organization-overlay",
        "gate:task-assurance",
        "gate:decision-sprint-linkage",
        "gate:local-ci-contract",
        "gate:delivery-lifecycle",
        "gate:provider-doc-evidence",
        "gate:filemap"
      ],
      "assurance": {
        "version": 1,
        "classification": "local_non_mutating",
        "safe_local_only": true,
        "capabilities": [
          "control_plane_completion"
        ],
        "env_allowlist": [],
        "commands": [
          {
            "id": "organization-gates",
            "argv": [
              "npm",
              "run",
              "gate:organization-overlay"
            ],
            "timeout_ms": 300000,
            "parser": {
              "kind": "patterns",
              "minimum_output_bytes": 1,
              "minimum_executed": 1,
              "required_patterns": [
                "check-organization-overlay: OK"
              ]
            }
          },
          {
            "id": "fleet-parity",
            "argv": [
              "npm",
              "run",
              "gate:fleet-parity"
            ],
            "timeout_ms": 300000,
            "parser": {
              "kind": "patterns",
              "minimum_output_bytes": 1,
              "minimum_executed": 1,
              "required_patterns": [
                "fleet-parity: PASS"
              ]
            }
          },
          {
            "id": "lifecycle-regressions",
            "argv": [
              "npm",
              "run",
              "test:organization-control-plane"
            ],
            "timeout_ms": 300000,
            "parser": {
              "kind": "tap",
              "minimum_output_bytes": 1,
              "minimum_executed": 1,
              "forbid_skips": true
            }
          },
          {
            "id": "task-assurance-contract",
            "argv": [
              "npm",
              "run",
              "gate:task-assurance"
            ],
            "timeout_ms": 300000,
            "parser": {
              "kind": "tap",
              "minimum_output_bytes": 1,
              "minimum_executed": 1,
              "forbid_skips": true
            }
          }
        ],
        "mutation": {
          "case_id": "forged-runner-attestation-rejected",
          "argv": [
            "npm",
            "run",
            "test:evidence-integrity-mutation"
          ],
          "timeout_ms": 60000,
          "receipt_marker": "MUTATION_RECEIPT_JSON:",
          "expected_diagnostic": "forged runner attestation was accepted"
        }
      }
    },
    "internal-read-only": {
      "commands": [],
      "assurance": {
        "version": 1,
        "classification": "internal_read_only",
        "safe_local_only": true,
        "capabilities": [
          "read_only_integrity"
        ],
        "commands": [
          {
            "id": "repository-binding",
            "argv": [
              "internal",
              "repository-binding"
            ],
            "timeout_ms": 1000,
            "parser": {
              "kind": "patterns",
              "minimum_output_bytes": 1,
              "minimum_executed": 1,
              "required_patterns": [
                "READ_ONLY_REPOSITORY_BINDING:"
              ]
            }
          }
        ]
      }
    },
    "backend": {
      "commands": [
        "prisma:generate",
        "typecheck",
        "lint",
        "format:check",
        "gate:test-intent",
        "gate:provider-doc-evidence"
      ]
    },
    "frontend": {
      "commands": [
        "typecheck",
        "lint",
        "format:check",
        "check:ui",
        "check:layout",
        "gate:test-intent",
        "gate:page-reachability"
      ]
    },
    "shared": {
      "commands": [
        "typecheck",
        "lint",
        "format:check",
        "gate:test-intent",
        "gate:endpoint-wiring"
      ]
    },
    "database": {
      "commands": [
        "prisma:generate",
        "typecheck",
        "lint",
        "format:check",
        "gate:test-intent",
        "gate:tx-seam",
        "gate:tx-rollback",
        "gate:lifecycle-write",
        "gate:provider-doc-evidence"
      ]
    },
    "docs": {
      "commands": [
        "format:check",
        "gate:doc-code-drift",
        "gate:doc-registry-refs",
        "gate:decision-sprint-linkage"
      ]
    },
    "project": {
      "commands": [
        "typecheck",
        "lint",
        "format:check"
      ]
    }
  }
}
