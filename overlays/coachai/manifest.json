      "source": "overlays/coachai/control-plane/registries/agent-roles.project.v1.json",
      "captureFrom": "${PROJECT:coachai}/.ai-organization/registries/agent-roles.project.v1.json",
      "destinations": [
        "${PROJECT:coachai}/.ai-organization/registries/agent-roles.project.v1.json"
      ],
      "mode": "file",
