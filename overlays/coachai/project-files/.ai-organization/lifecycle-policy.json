{
  "version": 1,
  "telemetry_directory": "tmp/agent-telemetry",
  "telemetry_content_policy": "hashes_counts_and_outcomes_only",
  "events": {
    "SessionStart": "record_baseline",
    "SubagentStart": "validate_role_and_brief",
    "TaskCreated": "validate_kickoff",
    "TaskCompleted": "require_completion_evidence_and_risk_proof",
    "SubagentStop": "validate_report_contract",
    "PostCompact": "record_context_transition",
    "SessionEnd": "record_outcome"
  },
  "post_tool_use": "separate_fast_gate_router"
}
