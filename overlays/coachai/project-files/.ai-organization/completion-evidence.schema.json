{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coachai-agent-completion-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "outcome", "changed_paths", "proof", "killer_mutations", "independent_review", "not_reached", "decisions", "doctrine_loop"],
  "properties": {
    "task_id": { "type": "string", "minLength": 3 },
    "outcome": { "type": "string", "minLength": 30 },
    "changed_paths": { "$ref": "#/$defs/strings" },
    "proof": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit", "proves"],
        "properties": {
          "command": { "type": "string", "minLength": 3 },
          "exit": { "const": 0 },
          "proves": { "type": "string", "minLength": 15 }
        }
      }
    },
    "killer_mutations": { "$ref": "#/$defs/strings" },
    "independent_review": { "type": "string", "minLength": 5 },
    "not_reached": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "decisions": { "type": "array", "items": { "type": "string", "minLength": 3 } },
    "doctrine_loop": { "type": "string", "minLength": 4 }
  },
  "$defs": { "strings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } } }
}
