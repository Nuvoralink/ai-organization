{
  "version": 1,
  "overlay_source": "universal-private-orchestrator/overlays/coachai",
  "managed_roots": [
    ".ai-organization",
    ".claude/agents",
    ".cursor/rules",
    "scripts/tests"
  ],
  "managed_files": [
    ".github/CODEOWNERS",
    ".github/ISSUE_TEMPLATE/agent-slice.yml",
    ".github/pull_request_template.md",
    ".github/workflows/backend-db-regressions.yml",
    ".github/workflows/ui-source-of-truth-gates.yml",
    "AGENTS.md",
    "CLAUDE.md",
    "scripts/check-agent-context.mjs",
    "scripts/check-agent-control-plane.mjs",
    "scripts/check-doc-code-drift.mjs",
    "scripts/check-fleet-parity.mjs",
    "scripts/check-overlay-parity.mjs",
    "scripts/check-rules-wiring.mjs",
    "scripts/check-test-intent.mjs",
    "scripts/ci-local.mjs",
    "scripts/claude-lifecycle-hook.mjs",
    "scripts/claude-posttooluse-gate.mjs",
    "scripts/claude-pretooluse-guard.mjs",
    "scripts/lib/boundedProcess.mjs",
    "scripts/lib/dispatchBoundary.mjs",
    "scripts/run-bounded-agent.mjs",
    "scripts/run-risk-selected-proof.mjs",
    "scripts/task-governor.mjs"
  ],
  "managed_json_sections": {
    ".claude/settings.json": [
      "hooks"
    ],
    "package.json": [
      "scripts.agent:run",
      "scripts.gate:agent-context",
      "scripts.gate:rules-wiring",
      "scripts.gate:agent-control-plane",
      "scripts.gate:fleet-parity",
      "scripts.gate:overlay-parity",
      "scripts.gate:organization",
      "scripts.proof:changed",
      "scripts.test:organization-control-plane",
      "scripts.test:evidence-integrity-mutation",
      "scripts.gates:all",
      "scripts.verify",
      "scripts.verify:db",
      "scripts.ci:local"
    ]
  },
  "excluded_project_owned": [
    "backend/**",
    "frontend/**",
    "shared/**",
    "docs/app-plan/product/**",
    "docs/app-plan/architecture/**",
    "docs/app-plan/decision-log.md",
    ".ai-organization/policies/coordination-mode.v1.json",
    "**/.env*",
    "**/node_modules/**",
    "**/__pycache__/**",
    "tmp/**"
  ],
  "append_only_markers": [
    "## Learned classes"
  ],
  "lock_file": ".ai-organization/overlay-lock.json"
}
