  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-posttooluse-gate.mjs"],
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ],
    "TaskCreated": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ],
    "TaskCompleted": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 1800 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude-lifecycle-hook.mjs"], "timeout": 30 }] }
    ]
  }
}
