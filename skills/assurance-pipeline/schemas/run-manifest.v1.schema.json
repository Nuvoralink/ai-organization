{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nuvoralink.internal/schemas/assurance-run-manifest.v1.schema.json",
  "title": "Assurance pipeline run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "pipeline",
    "config_sha256",
    "target_ref",
    "created_at",
    "updated_at",
    "stages"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "pipeline": { "type": "string", "minLength": 1 },
    "config_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "target_ref": { "type": "string" },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "artifact_path", "sha256", "bytes", "started_at", "ended_at"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "completed", "failed"] },
          "artifact_path": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"] },
          "bytes": { "type": ["integer", "null"] },
          "started_at": { "type": ["string", "null"] },
          "ended_at": { "type": ["string", "null"] }
        }
      }
    }
  }
}
