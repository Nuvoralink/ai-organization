      "Bash(npm run gate:agent-control-plane)",
      "Bash(npm run gate:test-intent)",
      // "Bash(npm run check:ui)",              // frontend products
      // "Bash(npm run check:layout)",          // frontend products
      "PowerShell(npm run typecheck)",
      "PowerShell(npm run lint)",
      "PowerShell(npm run format:check)",
      "PowerShell(npm run test)",
      "PowerShell(npm run gates:all)",
      "PowerShell(npm run gate:rules-wiring)",
      "PowerShell(npm run gate:agent-context)",
      "PowerShell(npm run gate:agent-control-plane)",
      "PowerShell(npm run gate:test-intent)"
      // Add read-only MCP tools the fleet uses (preview_* for ui-verifier, deploy-status reads for release-verifier, etc.).
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 1800
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-lifecycle-hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/claude-posttooluse-gate.mjs",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
