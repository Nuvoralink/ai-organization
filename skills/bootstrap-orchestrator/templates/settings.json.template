// Save as .claude/settings.json (strip these comment lines — JSON has no comments).
{
  "permissions": {
    "allow": [
      // FILL: one entry per real check/test command, in BOTH Bash(...) and PowerShell(...) form on Windows.
      // Discover from package.json scripts. Examples (replace with the repo's real ones):
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run test)",
      "Bash(npm run gates:all)",
      "Bash(npm run gate:rules-wiring)",
