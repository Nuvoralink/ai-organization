name: Agent slice
description: Six-part self-contained brief for one isolated agent/worktree slice
title: "[agent] "
body:
  - type: markdown
    attributes:
      value: "Every field is required and substantive. Quote settled MUST/MUST-NOT decisions inline."
  - type: dropdown
    id: completion_tier
    attributes:
      label: Completion tier
      options:
        - read-only
        - implementation
    validations: { required: true }
  - type: textarea
    id: context
    attributes:
      label: Context
      description: Product goal, settled decisions quoted inline, and crown-jewel invariants.
    validations: { required: true }
  - type: textarea
    id: exact_paths
    attributes:
      label: Exact paths
      description: Read, edit, read-but-never-modify, and output paths.
    validations: { required: true }
  - type: textarea
    id: numbered_procedure
    attributes:
      label: Numbered procedure
      description: Start at 1; include command-owned exit-code capture.
    validations: { required: true }
  - type: textarea
    id: output_contract
    attributes:
      label: Output contract
      description: Required report sections, proof lines, Doctrine-loop findings, and Honesty clause.
    validations: { required: true }
  - type: textarea
    id: boundaries_escalation
    attributes:
      label: Boundaries and escalation
      description: Scope/permission boundaries and the exact STOP/escalation path.
    validations: { required: true }
  - type: textarea
    id: acceptance_criteria
    attributes:
      label: Acceptance criteria
      description: Self-verifiable conditions, named gates, artifacts, and killer mutation.
    validations: { required: true }
  - type: textarea
    id: functional_acceptance
    attributes:
      label: Functional acceptance
      description: Original deployed user journey, deploy-safety boundary, acceptance observer, and which audit findings remain queue-only until it works.
      placeholder: |
        Original journey: <exact user action -> deployed effect>
        Deploy safety: <migration/schema, DB integrity, build/startup, deploy readiness>
        Acceptance authority: <human observer or runtime artifact>
        Pre-acceptance audits: queue without remediation except bounded interruption classes
    validations: { required: true }
  - type: textarea
    id: provider_documentation_evidence
    attributes:
      label: Provider documentation evidence
      description: Required for provider-facing changes; otherwise state N/A with the provider-path census.
      placeholder: |
        Official leaf docs: <current provider URLs>
        Installed SDK source/types inspected: <paths, methods, types>
        Exact contract claims: <request, response/webhook, idempotency, ordering>
        Deployed provider smoke: <real post-deploy effect>
    validations: { required: true }

