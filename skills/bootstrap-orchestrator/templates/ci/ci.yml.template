  #       with: { node-version: '{{NODE_VERSION}}', cache: 'npm' }
  #     - run: npm ci
  #     # {{PRISMA_GENERATE_STEP}}
  #     - run: npm run test:integration

  # OPTIONAL — keep ONLY if an alert channel is wired (a bot token in repo secrets). Alerts on a RED CI (a failed BUILD can't be
  # caught by an error tracker — no app is running to report). Plain curl, no third-party action (supply-chain discipline; this job
  # has secrets in scope). No-ops if the secrets aren't set. CoachAI deliberately has NO such channel — omit this job there.
